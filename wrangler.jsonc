{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "best-ip",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  // 线上页面 = 新前端：assets 根指向 frontend-next。旧 frontend/ 仍留在仓库里但不再被提供；
  // 回退只需把下面这一行改回 "./frontend"（scripts/verify_deploy.mjs 会跟着这一行换比对基准）。
  "assets": {
    "directory": "./frontend-next",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
